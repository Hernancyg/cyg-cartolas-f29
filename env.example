# Copia este archivo a `.env` (mismo directorio) para correr la app en
# local. NUNCA subas el `.env` real a GitHub — ya está en .gitignore.

# Project URL de Supabase (Project Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key de Supabase (Project Settings → API → service_role)
# OJO: no es la "anon" key. Esta clave tiene acceso total, nunca se expone
# al navegador — solo la usa el servidor Flask.
SUPABASE_KEY=

# Llave maestra: permite entrar como administrador sin necesidad de un
# usuario creado en la tabla `usuarios`. Elige una clave propia.
ADMIN_PASSWORD=

# Clave secreta de Flask (firma las cookies de sesión). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# 1 para desarrollo local (permite cookies sin HTTPS, activa el modo debug).
# En Render, dejar en 0 o no configurar.
FLASK_DEBUG=1

# Pestaña "Reuniones" (solo admin) — app registrada en Azure/Microsoft
# Entra ID con permiso de APLICACIÓN Calendars.Read (con consentimiento de
# administrador del tenant). Ver README.md, sección "Reuniones (Microsoft
# Graph)", para el paso a paso completo. Si se dejan vacías, la pestaña
# muestra un aviso de "falta configurar" en vez de romper la app.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_USER_UPN=
